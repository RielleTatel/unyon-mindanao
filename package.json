{
  "name": "unyon-mindanao-portal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#unyon-object-store": {
      "workerd": "./src/platform/r2/worker-runtime.ts",
      "default": "./src/platform/r2/local-runtime.ts"
    },
    "#unyon-prisma-client": {
      "workerd": "./src/platform/database/generated/client.ts",
      "default": "./src/platform/database/generated-node/client.ts"
    }
  },
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "backup:local": "node --import tsx scripts/backup-local.ts",
    "backup:verify:local": "node --import tsx scripts/backup-local.ts --verify-restore",
    "health:local": "node --import tsx scripts/health-local.ts",
    "predev": "pnpm env:check:local",
    "dev": "next dev",
    "predev:worker": "pnpm env:check:local",
    "dev:worker": "cross-env WRANGLER_LOG_PATH=.wrangler/logs vinext dev",
    "build": "next build --webpack",
    "build:worker": "cross-env WRANGLER_LOG_PATH=.wrangler/logs vinext build",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:test:prepare": "node --import tsx scripts/prepare-test-database.ts",
    "auth:emulator": "cross-env FIREBASE_CLI_DISABLE_UPDATE_CHECK=true firebase emulators:start --only auth --project unyon-mindanao-local",
    "bootstrap:super-admin": "node --conditions=react-server --import tsx scripts/bootstrap-super-admin.ts",
    "bootstrap:local": "node --conditions=react-server --import tsx scripts/bootstrap-local-super-admin.ts",
    "d1:migrate:local": "cross-env WRANGLER_LOG_PATH=.wrangler/logs wrangler d1 migrations apply unyon-mindanao-local-d1 --local --config wrangler.d1.local.jsonc",
    "d1:migrate:export:postgres": "node --import tsx scripts/postgres-to-d1.ts export",
    "d1:migrate:import:local": "node --import tsx scripts/postgres-to-d1.ts import-local",
    "d1:backup:local": "node --import tsx scripts/backup-d1-local.ts backup",
    "d1:restore:verify:local": "node --import tsx scripts/backup-d1-local.ts verify",
    "bootstrap:local:d1": "cross-env PERSISTENCE_PROVIDER=d1 node --conditions=react-server --import tsx scripts/bootstrap-local-super-admin.ts",
    "preview:worker:d1:local": "cross-env WRANGLER_LOG_PATH=.wrangler/logs wrangler dev --config wrangler.d1.local.jsonc --port 3000 --ip 127.0.0.1",
    "prepreview": "pnpm env:check:local",
    "preview": "cross-env WRANGLER_LOG_PATH=.wrangler/logs vinext start",
    "prepreview:worker": "pnpm env:check:local",
    "preview:worker": "cross-env WRANGLER_LOG_PATH=.wrangler/logs wrangler dev --config dist/server/wrangler.json --port 3000",
    "predeploy:check": "pnpm env:check:local",
    "deploy:check": "cross-env WRANGLER_LOG_PATH=.wrangler/logs vinext-cloudflare deploy --dry-run",
    "predeploy": "pnpm env:check:production",
    "deploy": "cross-env WRANGLER_LOG_PATH=.wrangler/logs vinext-cloudflare deploy",
    "predeploy:preview": "pnpm env:check:preview",
    "deploy:preview": "node --import tsx scripts/deploy-preview.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest:integration": "pnpm db:test:prepare",
    "test:integration": "vitest run --config vitest.integration.config.ts --passWithNoTests",
    "test:e2e": "playwright test",
    "test:e2e:worker": "playwright test --config playwright.worker.config.ts",
    "env:check": "node --import tsx scripts/validate-environment.ts",
    "env:check:local": "node --import tsx scripts/validate-environment.ts local",
    "env:check:preview": "node --import tsx scripts/validate-environment.ts preview",
    "env:check:production": "node --import tsx scripts/validate-environment.ts production",
    "cf:typegen": "cross-env WRANGLER_LOG_PATH=.wrangler/logs wrangler types"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@vinext/cloudflare": "1.0.0-beta.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "firebase": "^12.19.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.46.0",
    "next": "^16.3.5",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-server-dom-webpack": "^19.3.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "vinext": "1.0.0-beta.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/vite-plugin": "^1.54.9",
    "@cloudflare/workers-types": "^5.20260915.1",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.5.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.34",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "firebase-tools": "15.25.1",
    "jsdom": "^30.0.1",
    "prisma": "7.10.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.0",
    "wrangler": "^4.131.2"
  }
}
