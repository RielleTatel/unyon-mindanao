{
  "name": "unyon-mindanao-portal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "predev": "pnpm env:check:local",
    "dev": "next dev",
    "predev:worker": "pnpm env:check:local",
    "dev:worker": "cross-env WRANGLER_LOG_PATH=.wrangler/logs vinext dev",
    "build": "next build --webpack",
    "build:worker": "cross-env WRANGLER_LOG_PATH=.wrangler/logs vinext build",
    "prepreview": "pnpm env:check:local",
    "preview": "cross-env WRANGLER_LOG_PATH=.wrangler/logs vinext start",
    "predeploy:check": "pnpm env:check:local",
    "deploy:check": "cross-env WRANGLER_LOG_PATH=.wrangler/logs vinext-cloudflare deploy --dry-run",
    "predeploy": "pnpm env:check:production",
    "deploy": "cross-env WRANGLER_LOG_PATH=.wrangler/logs vinext-cloudflare deploy",
    "predeploy:preview": "pnpm env:check:preview",
    "deploy:preview": "cross-env WRANGLER_LOG_PATH=.wrangler/logs vinext-cloudflare deploy --preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts --passWithNoTests",
    "test:e2e": "playwright test",
    "test:e2e:worker": "playwright test --config playwright.worker.config.ts",
    "env:check": "node --import tsx scripts/validate-environment.ts",
    "env:check:local": "node --import tsx scripts/validate-environment.ts local",
    "env:check:preview": "node --import tsx scripts/validate-environment.ts preview",
    "env:check:production": "node --import tsx scripts/validate-environment.ts production",
    "cf:typegen": "cross-env WRANGLER_LOG_PATH=.wrangler/logs wrangler types"
  },
  "dependencies": {
    "@vinext/cloudflare": "1.0.0-beta.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.46.0",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-server-dom-webpack": "^19.3.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "vinext": "1.0.0-beta.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.9",
    "@cloudflare/workers-types": "^5.20260915.1",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.34",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.0",
    "wrangler": "^4.131.2"
  }
}
