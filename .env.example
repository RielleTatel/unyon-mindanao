# Local development defaults to http://localhost:3000 when this is omitted.
# Preview and production must provide an HTTPS origin.
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000
APP_ENV=local

# Local PostgreSQL. Production DATABASE_URL uses the Supabase transaction pooler;
# DIRECT_URL is reserved for migration commands.
DATABASE_URL=postgresql://unyon:unyon@127.0.0.1:5432/unyon?schema=public
DIRECT_URL=postgresql://unyon:unyon@127.0.0.1:5432/unyon?schema=public
# Integration tests refuse to run unless this URL names a dedicated *_test database.
TEST_DATABASE_URL=postgresql://unyon:unyon@127.0.0.1:5432/unyon_access_test?schema=public

# Firebase browser identity configuration. The local project uses Auth Emulator.
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=unyon-mindanao-local.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=unyon-mindanao-local
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_PROJECT_ID=unyon-mindanao-local
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Invitation email delivery uses Resend. Configure these before inviting real users.
RESEND_API_KEY=
INVITATION_FROM_EMAIL=

# Local emulator bootstrap only. Never reuse these credentials outside local development.
LOCAL_SUPER_ADMIN_EMAIL=admin@unyon.local
LOCAL_SUPER_ADMIN_PASSWORD=change-this-local-password
LOCAL_SUPER_ADMIN_NAME=Local Super Admin

# Controlled production bootstrap. Supply these only to the one-off command.
BOOTSTRAP_EMAIL=
BOOTSTRAP_FIREBASE_UID=
BOOTSTRAP_FULL_NAME=
