generator client {
  provider = "prisma-client"
  output   = "../src/platform/database/generated"
  runtime  = "workerd"
}

generator clientNode {
  provider = "prisma-client"
  output   = "../src/platform/database/generated-node"
  runtime  = "nodejs"
}

datasource db {
  provider = "postgresql"
}

enum PortalUserStatus {
  ACTIVE
  DISABLED
}

enum PortalRole {
  SUPER_ADMIN
  UNIVERSITY_ADMIN
  REPRESENTATIVE
}

enum MemberUniversityStatus {
  ACTIVE
  ARCHIVED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum EventLifecycleStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
  ARCHIVED
}

enum AnnouncementStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Announcement {
  id          String             @id @default(uuid()) @db.Uuid
  title       String             @db.VarChar(180)
  body        String             @db.VarChar(10000)
  status      AnnouncementStatus @default(DRAFT)
  version     Int                @default(1)
  publishedAt DateTime?          @map("published_at") @db.Timestamptz(6)
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, publishedAt])
  @@map("announcements")
}

model Shortcut {
  id        String   @id @default(uuid()) @db.Uuid
  label     String   @db.VarChar(120)
  url       String   @db.VarChar(2000)
  icon      String?  @db.VarChar(48)
  sortOrder Int      @default(0) @map("sort_order")
  active    Boolean  @default(true)
  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([active, sortOrder])
  @@map("shortcuts")
}

model PortalUser {
  id                  String           @id @default(uuid()) @db.Uuid
  firebaseUid         String           @unique @map("firebase_uid") @db.VarChar(128)
  email               String           @unique @db.VarChar(320)
  fullName            String           @map("full_name") @db.VarChar(160)
  birthDate           DateTime?        @map("birth_date") @db.Date
  birthDateVersion    Int              @default(0) @map("birth_date_version")
  profileObjectId     String?          @unique @map("profile_object_id") @db.Uuid
  profileObject       StoredObject?    @relation("ProfileObject", fields: [profileObjectId], references: [id], onDelete: Restrict)
  status              PortalUserStatus @default(ACTIVE)
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  appointments        Appointment[]
  sessions            PortalSession[]
  auditLogs           AuditLog[]       @relation("AuditActor")
  sentInvitations     Invitation[]     @relation("InvitationInviter")
  acceptedInvitations Invitation[]     @relation("InvitationAcceptedBy")
  createdEvents       Event[]          @relation("EventCreator")

  @@map("portal_users")
}

model MemberUniversity {
  id           String                 @id @default(uuid()) @db.Uuid
  name         String                 @db.VarChar(180)
  slug         String                 @db.VarChar(160)
  description  String?                @db.VarChar(1000)
  status       MemberUniversityStatus @default(ACTIVE)
  createdAt    DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  appointments Appointment[]
  invitations  Invitation[]
  ownedEvents  Event[]          @relation("EventOwningUniversity")
  coHostedEvents EventCoHost[]

  @@map("member_universities")
}

model Appointment {
  id           String            @id @default(uuid()) @db.Uuid
  portalUserId String            @map("portal_user_id") @db.Uuid
  role         PortalRole
  universityId String?           @map("university_id") @db.Uuid
  startsAt     DateTime          @map("starts_at") @db.Timestamptz(6)
  endsAt       DateTime?         @map("ends_at") @db.Timestamptz(6)
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  portalUser   PortalUser        @relation(fields: [portalUserId], references: [id], onDelete: Restrict)
  university   MemberUniversity? @relation(fields: [universityId], references: [id], onDelete: Restrict)

  @@index([portalUserId, startsAt, endsAt])
  @@index([role, universityId])
  @@map("appointments")
}

model Invitation {
  id                     String           @id @default(uuid()) @db.Uuid
  tokenHash              String           @unique @map("token_hash") @db.Char(64)
  email                  String           @db.VarChar(320)
  role                   PortalRole
  status                 InvitationStatus @default(PENDING)
  universityId           String           @map("university_id") @db.Uuid
  invitedByPortalUserId  String           @map("invited_by_portal_user_id") @db.Uuid
  acceptedByPortalUserId String?          @map("accepted_by_portal_user_id") @db.Uuid
  expiresAt              DateTime         @map("expires_at") @db.Timestamptz(6)
  acceptedAt             DateTime?        @map("accepted_at") @db.Timestamptz(6)
  revokedAt              DateTime?        @map("revoked_at") @db.Timestamptz(6)
  createdAt              DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  university             MemberUniversity @relation(fields: [universityId], references: [id], onDelete: Restrict)
  invitedBy              PortalUser       @relation("InvitationInviter", fields: [invitedByPortalUserId], references: [id], onDelete: Restrict)
  acceptedBy             PortalUser?      @relation("InvitationAcceptedBy", fields: [acceptedByPortalUserId], references: [id], onDelete: Restrict)

  @@index([status, expiresAt])
  @@index([universityId, createdAt])
  @@map("invitations")
}

model PortalSession {
  id           String     @id @default(uuid()) @db.Uuid
  portalUserId String     @map("portal_user_id") @db.Uuid
  tokenHash    String     @unique @map("token_hash") @db.Char(64)
  expiresAt    DateTime   @map("expires_at") @db.Timestamptz(6)
  revokedAt    DateTime?  @map("revoked_at") @db.Timestamptz(6)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  portalUser   PortalUser @relation(fields: [portalUserId], references: [id], onDelete: Restrict)

  @@index([portalUserId, expiresAt])
  @@map("portal_sessions")
}

model AuditLog {
  id                String      @id @default(uuid()) @db.Uuid
  actorPortalUserId String?     @map("actor_portal_user_id") @db.Uuid
  action            String      @db.VarChar(120)
  resourceType      String      @map("resource_type") @db.VarChar(120)
  resourceId        String      @map("resource_id") @db.VarChar(160)
  correlationId     String      @map("correlation_id") @db.VarChar(160)
  metadata          Json        @default("{}")
  occurredAt        DateTime    @map("occurred_at") @db.Timestamptz(6)
  actor             PortalUser? @relation("AuditActor", fields: [actorPortalUserId], references: [id], onDelete: SetNull)

  @@index([actorPortalUserId, occurredAt])
  @@index([resourceType, resourceId, occurredAt])
  @@index([correlationId])
  @@map("audit_logs")
}

model Event {
  id                  String               @id @default(uuid()) @db.Uuid
  title               String               @db.VarChar(180)
  description         String               @db.VarChar(5000)
  category            String               @db.VarChar(80)
  status              EventLifecycleStatus @default(DRAFT)
  startsAt            DateTime             @map("starts_at") @db.Timestamptz(6)
  endsAt              DateTime             @map("ends_at") @db.Timestamptz(6)
  allDay              Boolean              @default(false) @map("all_day")
  location            String?              @db.VarChar(300)
  onlineUrl           String?              @map("online_url") @db.VarChar(2000)
  contactPerson       String?              @map("contact_person") @db.VarChar(160)
  ownerUniversityId   String?              @map("owner_university_id") @db.Uuid
  createdByPortalUserId String             @map("created_by_portal_user_id") @db.Uuid
  publishedAt         DateTime?            @map("published_at") @db.Timestamptz(6)
  cancelledAt         DateTime?            @map("cancelled_at") @db.Timestamptz(6)
  completedAt         DateTime?            @map("completed_at") @db.Timestamptz(6)
  archivedAt          DateTime?            @map("archived_at") @db.Timestamptz(6)
  version             Int                  @default(1)
  coverObjectId       String?              @unique @map("cover_object_id") @db.Uuid
  coverObject         StoredObject?        @relation("EventCoverObject", fields: [coverObjectId], references: [id], onDelete: Restrict)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  ownerUniversity     MemberUniversity?    @relation("EventOwningUniversity", fields: [ownerUniversityId], references: [id], onDelete: Restrict)
  createdBy           PortalUser           @relation("EventCreator", fields: [createdByPortalUserId], references: [id], onDelete: Restrict)
  coHosts             EventCoHost[]

  @@index([status, startsAt])
  @@index([ownerUniversityId, status, startsAt])
  @@map("events")
}

model EventCoHost {
  eventId      String          @map("event_id") @db.Uuid
  universityId String          @map("university_id") @db.Uuid
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  event        Event           @relation(fields: [eventId], references: [id], onDelete: Restrict)
  university   MemberUniversity @relation(fields: [universityId], references: [id], onDelete: Restrict)

  @@id([eventId, universityId])
  @@index([universityId, eventId])
  @@map("event_co_hosts")
}

model EvaluationTemplateVersion {
  id        String   @id @default(uuid()) @db.Uuid
  version   Int      @unique
  questions Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  @@map("evaluation_template_versions")
}

model EventEvaluationWindow {
  eventId    String   @id @map("event_id") @db.Uuid
  templateId String   @map("template_id") @db.Uuid
  opensAt    DateTime @map("opens_at") @db.Timestamptz(6)
  closesAt   DateTime @map("closes_at") @db.Timestamptz(6)
  closed     Boolean  @default(false)
  version    Int      @default(1)
  @@map("event_evaluation_windows")
}

model EvaluationResponse {
  id           String   @id @default(uuid()) @db.Uuid
  eventId      String   @map("event_id") @db.Uuid
  portalUserId String   @map("portal_user_id") @db.Uuid
  version      Int      @default(1)
  submittedAt  DateTime @default(now()) @map("submitted_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  answers      EvaluationAnswer[]
  @@unique([eventId, portalUserId])
  @@map("evaluation_responses")
}

model EvaluationAnswer {
  responseId String @map("response_id") @db.Uuid
  position   Int
  rating     Int?
  comment    String? @db.VarChar(2000)
  response   EvaluationResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  @@id([responseId, position])
  @@map("evaluation_answers")
}

enum StoredObjectPurpose {
  PROFILE_IMAGE
  EVENT_COVER
  FINANCIAL_REPORT
}

enum StoredObjectStatus {
  PENDING
  AVAILABLE
  FAILED
}

model StoredObject {
  id          String              @id @default(uuid()) @db.Uuid
  key         String              @unique @db.VarChar(200)
  purpose     StoredObjectPurpose
  resourceId  String              @map("resource_id") @db.Uuid
  uploaderId  String              @map("uploader_id") @db.Uuid
  mimeType    String              @map("mime_type") @db.VarChar(100)
  size        Int
  sha256      String?             @db.Char(64)
  status      StoredObjectStatus  @default(PENDING)
  expiresAt   DateTime            @map("expires_at") @db.Timestamptz(6)
  cleanedAt   DateTime?           @map("cleaned_at") @db.Timestamptz(6)
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  profiles    PortalUser[]        @relation("ProfileObject")
  events      Event[]             @relation("EventCoverObject")
  revisions   FinancialReportRevision[]

  @@index([status, expiresAt])
  @@map("stored_objects")
}

enum FinancialReportRevisionStatus {
  DRAFT
  PUBLISHED
  SUPERSEDED
}

model FinancialReport {
  id            String                    @id @default(uuid()) @db.Uuid
  title         String                    @db.VarChar(180)
  reportingPeriod String                  @map("reporting_period") @db.VarChar(120)
  description   String                    @db.VarChar(3000)
  createdAt     DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  revisions     FinancialReportRevision[]

  @@map("financial_reports")
}

model FinancialReportRevision {
  id            String                        @id @default(uuid()) @db.Uuid
  reportId      String                        @map("report_id") @db.Uuid
  revision      Int
  status        FinancialReportRevisionStatus @default(DRAFT)
  objectId      String?                       @unique @map("object_id") @db.Uuid
  publishedById String?                       @map("published_by_id") @db.Uuid
  publishedAt   DateTime?                     @map("published_at") @db.Timestamptz(6)
  supersededAt  DateTime?                     @map("superseded_at") @db.Timestamptz(6)
  createdAt     DateTime                      @default(now()) @map("created_at") @db.Timestamptz(6)
  report        FinancialReport              @relation(fields: [reportId], references: [id], onDelete: Restrict)
  object        StoredObject?                @relation(fields: [objectId], references: [id], onDelete: Restrict)

  @@unique([reportId, revision])
  @@map("financial_report_revisions")
}
